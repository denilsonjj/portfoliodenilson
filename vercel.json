{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/cron/supabase-keepalive",
      "schedule": "15 12 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/projetos/:slug",
      "destination": "/projetos/:slug.html"
    },
    {
      "source": "/servicos/:slug",
      "destination": "/servicos/:slug.html"
    },
    {
      "source": "/(.*)",
      "destination": "/app.html"
    }
  ]
}
